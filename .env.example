# Brave Search API Key
# Get your API key from: https://brave.com/search/api/
VITE_BRAVE_API_KEY=your_brave_api_key_here

# Financial Data APIs
# Alpha Vantage API (free tier available): https://www.alphavantage.co/support/#api-key
VITE_ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Polygon.io API (free tier available): https://polygon.io/
VITE_POLYGON_API_KEY=your_polygon_key_here

# Financial Modeling Prep API (free tier available): https://financialmodelingprep.com/
VITE_FMP_API_KEY=your_fmp_key_here

# Note: In production, never expose API keys in the frontend.
# This should be handled by your backend API to keep keys secure.